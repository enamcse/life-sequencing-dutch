        "begOrEnd",
        "daysSinceFirstEvent",
        "age"
      ],
      "numeric_cols": [
        "daysSinceFirstEvent",
        "age"
      ],
      "string_cols": [
        "GGZDBCZorgtypeHOOFDDIAG",
        "GGZDBCCircuitHOOFDDIAG",
        "GGZDBCHoofddiagnoseDSMIVHOOFDDIAG",
        "begOrEnd"
      ],
      "meta_sav": "for_meta/mental_health.sav"
